{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "@cloudflare/workers-types"
    ],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": true
  },
  "include": [
    "src/**/*.ts",
    "../shared/**/*.ts"
  ]
}
