{
  "name": "server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.dev.vars src/local.ts",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "build": "esbuild src/cloudflare/worker.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js --metafile=dist/meta.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@openrouter/sdk": "^1.4.18",
    "chess.js": "^1.4.0",
    "hono": "^4.11.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260421.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  }
}
